# Postgres (apps/api)
DATABASE_URL=postgresql://champion:champion@localhost:5432/championforge

# Auth (apps/api)
# Required — no default is provided. Must be at least 32 characters (e.g.
# `openssl rand -base64 32`) — a short, memorable phrase is not enough entropy
# for an HMAC-SHA256 signing key.
JWT_SECRET=change-me-to-a-random-32-char-secret-before-first-boot
WEB_ORIGIN=http://localhost:5173
# Set NODE_ENV=production for any real (non-localhost) deployment so the
# login cookie's `Secure` flag engages (requires HTTPS). Leave unset for
# local dev via docker-compose, which serves over plain HTTP.

# Optional. Only set when running behind a reverse proxy (e.g. docker-compose.https.yml's
# bundled Caddy) -- the exact number of proxy hops to trust for X-Forwarded-*, so the
# rate limiter sees the real client IP instead of the proxy's. Leave unset for the default
# docker-compose.yml (app reachable directly, no proxy in front).
#TRUST_PROXY_HOPS=1

# Bootstrap (apps/api — run once via `npm run bootstrap:admin -w apps/api`)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-in-production
ORGANIZATION_NAME=My Organization

# Frontend (apps/web)
# Only used when running `npm run dev -w apps/web` directly (not via Docker Compose):
# the Vite dev server (:5173) and the API (:3000) are different origins there, so the
# full URL is needed. The Docker Compose image serves web and api from the same origin
# and is built with VITE_API_URL=/api baked in -- this value is not read at runtime.
VITE_API_URL=http://localhost:3000/api
